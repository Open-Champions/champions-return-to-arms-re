+// The unit's numbers (as tools/recomp/render/vu1_step.h has them for VU1).  An exponent of
+// 255 is an ordinary exponent - the unit has no infinity and no NaN - and an exponent of 0
+// is zero whatever the fraction says.  With the host's own arithmetic an operand of
+// exponent 255 gave an infinity or a NaN, and a NaN's sign bit is the host's choice: an
+// ARM64 processor makes 0x7fc00000, an x86-64 one 0xffc00000 (and each hands an operand's
+// NaN on in its own way), so two builds of this file disagreed on such operands.  So what
+// an arithmetic instruction reads is brought into range first - the largest number of its
+// sign for exponent 255, zero for exponent 0 - and a result too small to be a number is
+// zero.  Results cannot overflow or be a NaN then: the operands are finite and the host
+// rounds toward zero while the game's threads run.  MAX and MINI compare the two bit
+// patterns as sign and magnitude and hand one of them on unchanged.
+static inline float vu_in(float f) {
+    u32 r = vu_raw(f), e = r & 0x7F800000u;
+    if (e == 0x7F800000u) return vu_flt((r & 0x80000000u) | 0x7F7FFFFFu);
+    if (e == 0) return vu_flt(r & 0x80000000u);
+    return f;
+}
+static inline float vu_out(float f) {
+    u32 r = vu_raw(f);
+    return (r & 0x7F800000u) ? f : vu_flt(r & 0x80000000u);
+}
+static inline s32 vu_key(float f) {
+    u32 r = vu_raw(f);
+    return (r & 0x80000000u) ? -(s32)(r & 0x7FFFFFFFu) : (s32)r;
+}
+
 // arithmetic whose result depends on the processor's state: the host's own (the runtime
 // sets toward zero and flush-to-zero), or tools/recomp/web/soft_rz.h on a host that
 // cannot (fpu.h says more)
 #ifdef RTA_SOFT_RZ
-static inline float vu_add(float a, float b) { return softrz::add_fz(a, b); }
