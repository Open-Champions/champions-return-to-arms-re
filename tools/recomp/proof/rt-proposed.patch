-static inline float vu_mul(float a, float b) { return softrz::mul_fz(a, b); }
+static inline float vu_add(float a, float b) { return vu_out(softrz::add_fz(vu_in(a), vu_in(b))); }
+static inline float vu_sub(float a, float b) { return vu_out(softrz::sub_fz(vu_in(a), vu_in(b))); }
+static inline float vu_mul(float a, float b) { return vu_out(softrz::mul_fz(vu_in(a), vu_in(b))); }
 static inline float vu_itof(s32 v) { return softrz::from_int(v); }
-static inline bool vu_gt(float a, float b) { return softrz::flush(a) > softrz::flush(b); }  // the compare reads tiny numbers as zero
 #else
-static inline float vu_add(float a, float b) { return a + b; }
-static inline float vu_sub(float a, float b) { return a - b; }
-static inline float vu_mul(float a, float b) { return a * b; }
+static inline float vu_add(float a, float b) { return vu_out(vu_in(a) + vu_in(b)); }
+static inline float vu_sub(float a, float b) { return vu_out(vu_in(a) - vu_in(b)); }
+static inline float vu_mul(float a, float b) { return vu_out(vu_in(a) * vu_in(b)); }
 static inline float vu_itof(s32 v) { return (float)v; }
-static inline bool vu_gt(float a, float b) { return a > b; }
 #endif
+static inline bool vu_gt(float a, float b) { return vu_key(a) > vu_key(b); }
 
