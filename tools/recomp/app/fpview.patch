-    return g_cycles + (u64)(POLL_UNITS - (c->budget < 0 ? 0 : c->budget)) * CYCLES_PER_UNIT;
+    return g_cycles + slice_cycles(c);
 }
 
+void rt_unit_cost(Ctx* c, unsigned cycles) {
