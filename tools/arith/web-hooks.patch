+	// DEV: a scripted step with everything in it: 'buttons' held and both sticks at the
+	// given places (0..255, 128 at rest) for 'frames' frames.
+	EMSCRIPTEN_KEEPALIVE void rtaStep(uint32 buttons, uint32 lx, uint32 ly, uint32 rx, uint32 ry, uint32 frames)
+	{
+		if(!frames) return;
+		std::lock_guard lock(g_mutex);
+		Step step;
+		step.buttons = buttons;
+		step.frames = frames;
+		step.stick = (lx != 128) || (ly != 128);
+		step.x = static_cast<uint8>(std::min<uint32>(lx, 255));
+		step.y = static_cast<uint8>(std::min<uint32>(ly, 255));
+		step.stickRight = (rx != 128) || (ry != 128);
+		step.rx = static_cast<uint8>(std::min<uint32>(rx, 255));
+		step.ry = static_cast<uint8>(std::min<uint32>(ry, 255));
+		g_steps.push_back(step);
+	}
+
+	// DEV: 'value' (1, 2 or 4 bytes) is written to the game's memory at 'address' in
+	// vertical blank number 'frame' (the machine's first one is 1), on the machine's thread,
+	// before that blank's presses are given and before rtaTrace / rtaWatch read. Data only:
+	// translated code that covers the address is not thrown away.
+	EMSCRIPTEN_KEEPALIVE void rtaPokeAt(uint32 frame, uint32 address, uint32 size, uint32 value)
+	{
+		std::lock_guard lock(g_mutex);
+		TimedPoke poke;
+		poke.frame = frame;
+		poke.address = address;
+		poke.size = (size == 1 || size == 2) ? size : 4;
+		poke.value = value;
+		g_timedPokes.push_back(poke);
+	}
+
+	// DEV: several places of the game's memory, taken together at every vertical blank.
+	// rtaWatchAdd names one more place ('size' bytes at 'offset', or at 'offset' past the
+	// pointer stored at 'pointer'; at most 4096 bytes per frame in all) and returns the
+	// number of bytes per frame so far; rtaWatchStart takes them for 'frames' frames from
+	// the next vertical blank on; rtaWatchRead gives what was taken as hexadecimal text,
+	// frame after frame, place after place - or nothing while frames are still to come.
+	EMSCRIPTEN_KEEPALIVE uint32 rtaWatchAdd(uint32 pointer, uint32 offset, uint32 size)
+	{
+		std::lock_guard lock(g_mutex);
+		if(g_watch.left == 0 && size != 0 && (g_watch.rowSize + size) <= 4096)
+		{
+			WatchRegion region;
+			region.pointer = pointer & 0x1FFFFFFF;
+			region.offset = offset;
+			region.size = size;
+			g_watch.regions.push_back(region);
+			g_watch.rowSize += size;
+		}
+		return g_watch.rowSize;
+	}
+
+	EMSCRIPTEN_KEEPALIVE void rtaWatchStart(uint32 frames)
+	{
+		std::lock_guard lock(g_mutex);
+		g_watch.bytes.clear();
+		g_watch.left = std::min<uint32>(frames, 1000000);
+	}
+
+	EMSCRIPTEN_KEEPALIVE const char* rtaWatchRead()
+	{
+		static std::string text;
+		std::lock_guard lock(g_mutex);
+		text.clear();
+		if(g_watch.left != 0) return text.c_str(); // not finished
+		static const char* digits = "0123456789abcdef";
+		text.reserve(g_watch.bytes.size() * 2);
+		for(uint8 byte : g_watch.bytes)
+		{
+			text += digits[byte >> 4];
+			text += digits[byte & 15];
+		}
+		return text.c_str();
+	}
