+//RTA: Puts the texels of a texture of any size into m_pCvtBuffer, row after row, without
+//uploading anything.
+//
+//The updaters for 4-bit and 8-bit textures copy whole blocks (32 or 16 texels across)
+//and take the width to be a multiple of that, as the powers of two TEX0 names are; the
+//bar that shows a character's health is a 4-bit texture 104 texels wide, and converted
+//at that width every row spilled its last 24 texels over the start of the next. So the
+//conversion is done at the next multiple and the rows are moved together afterwards.
+void CGSH_OpenGL::ConvertTexture(const TEX0& tex0, uint32 texWidth, uint32 texHeight)
+{
+	uint32 blockWidth = 1;
+	if((tex0.nPsm == PSMT4) && (texWidth > 16)) blockWidth = 32;
+	if((tex0.nPsm == PSMT8) && (texWidth >= 16)) blockWidth = 16;
+	uint32 convertWidth = ((texWidth + blockWidth - 1) / blockWidth) * blockWidth;
+	m_texConvertOnly = true;
+	((this)->*(m_textureUpdater[tex0.nPsm]))(tex0.GetBufPtr(), tex0.nBufWidth, 0, 0, convertWidth, texHeight);
+	m_texConvertOnly = false;
+	if(convertWidth != texWidth)
+	{
+		//indexed formats only: a byte per texel
+		for(uint32 y = 1; y < texHeight; y++)
+		{
+			memmove(m_pCvtBuffer + (static_cast<size_t>(y) * texWidth), m_pCvtBuffer + (static_cast<size_t>(y) * convertWidth), texWidth);
