--- a/Source/FpUtils.cpp
+++ b/Source/FpUtils.cpp
@@ -25,6 +25,117 @@
 
 #define EXC_FP_MAX 0x7F7FFFFF
 
+//RTA: the arithmetic of translated code (FpUtils.h)
+#include <atomic>
+#include <fenv.h>
+
+static std::atomic<int> g_arithmetic(FpUtils::ARITHMETIC_NATIVE);
+
+void FpUtils::SetArithmetic(ARITHMETIC arithmetic)
+{
+	g_arithmetic = arithmetic;
+}
+
+FpUtils::ARITHMETIC FpUtils::GetArithmetic()
+{
+	return static_cast<ARITHMETIC>(g_arithmetic.load());
+}
+
+#ifdef DENORM_AARCH64
+//The floating-point control register: rounding mode in bits 23:22 (0 nearest, 3 toward
+//zero), bit 24 flush-to-zero (denormal results become zero and denormal operands are
+//read as zero), bit 25 default-NaN. Bits 0 to 2 (FIZ, AH, NEP) change what flushing and
+//NaNs do on processors that have them; a new thread has all of these clear, and that is
+//the state WebAssembly code is run in.
+static const uint64 FPCR_RMODE_MASK = (3 << 22);
+static const uint64 FPCR_RMODE_ZERO = (3 << 22);
+static const uint64 FPCR_FZ = (1 << 24);
+static const uint64 FPCR_DN = (1 << 25);
+static const uint64 FPCR_ALT = 7;
+
+static uint64 ReadFpcr()
+{
+	uint64 value = 0;
+	__asm__ __volatile__("mrs %0, fpcr" : "=r"(value));
+	return value;
+}
+
+static void WriteFpcr(uint64 value)
+{
+	__asm__ __volatile__("msr fpcr, %0" : : "r"(value));
+}
+
+static uint64 WantedFpcr(uint64 fpcr, FpUtils::ARITHMETIC arithmetic)
+{
+	if(arithmetic == FpUtils::ARITHMETIC_BROWSER)
+	{
+		return fpcr & ~(FPCR_RMODE_MASK | FPCR_FZ | FPCR_DN | FPCR_ALT);
+	}
+	//What fesetround(FE_TOWARDZERO) and SetDenormalHandlingMode leave
+	return (fpcr & ~FPCR_RMODE_MASK) | FPCR_RMODE_ZERO | FPCR_FZ;
+}
+
+FpUtils::ARITHMETIC FpUtils::GetThreadArithmetic()
+{
+	uint64 fpcr = ReadFpcr();
+	return ((fpcr & (FPCR_RMODE_MASK | FPCR_FZ)) == 0) ? ARITHMETIC_BROWSER : ARITHMETIC_NATIVE;
+}
+
+bool FpUtils::ApplyThreadArithmetic()
+{
+	uint64 fpcr = ReadFpcr();
+	uint64 wanted = WantedFpcr(fpcr, GetArithmetic());
+	if(wanted == fpcr) return false;
+	WriteFpcr(wanted);
+	return true;
+}
+#elif defined(DENORM_X86)
+FpUtils::ARITHMETIC FpUtils::GetThreadArithmetic()
+{
+	bool nearest = (fegetround() == FE_TONEAREST);
+	bool flushing = (_MM_GET_DENORMALS_ZERO_MODE() == _MM_DENORMALS_ZERO_ON) || (_MM_GET_FLUSH_ZERO_MODE() == _MM_FLUSH_ZERO_ON);
+	return (nearest && !flushing) ? ARITHMETIC_BROWSER : ARITHMETIC_NATIVE;
+}
+
+bool FpUtils::ApplyThreadArithmetic()
+{
+	bool browser = (GetArithmetic() == ARITHMETIC_BROWSER);
+	int round = browser ? FE_TONEAREST : FE_TOWARDZERO;
+	unsigned int denormalsZero = browser ? _MM_DENORMALS_ZERO_OFF : _MM_DENORMALS_ZERO_ON;
+	unsigned int flushZero = browser ? _MM_FLUSH_ZERO_OFF : _MM_FLUSH_ZERO_ON;
+	if((fegetround() == round) && (_MM_GET_DENORMALS_ZERO_MODE() == denormalsZero) && (_MM_GET_FLUSH_ZERO_MODE() == flushZero)) return false;
+	fesetround(round);
+	_MM_SET_DENORMALS_ZERO_MODE(denormalsZero);
+	_MM_SET_FLUSH_ZERO_MODE(flushZero);
+	return true;
+}
+#elif defined(__EMSCRIPTEN__)
+//WebAssembly: always to nearest, denormals kept; nothing to choose.
+FpUtils::ARITHMETIC FpUtils::GetThreadArithmetic()
+{
+	return ARITHMETIC_BROWSER;
+}
+
+bool FpUtils::ApplyThreadArithmetic()
+{
+	return false;
+}
+#else
+//Hosts this was not written for: the rounding mode only, as Play! did.
+FpUtils::ARITHMETIC FpUtils::GetThreadArithmetic()
+{
+	return (fegetround() == FE_TONEAREST) ? ARITHMETIC_BROWSER : ARITHMETIC_NATIVE;
+}
+
+bool FpUtils::ApplyThreadArithmetic()
+{
+	int round = (GetArithmetic() == ARITHMETIC_BROWSER) ? FE_TONEAREST : FE_TOWARDZERO;
+	if(fegetround() == round) return false;
+	fesetround(round);
+	return true;
+}
+#endif
+
