@@ -9,6 +9,31 @@
 	void SetDenormalHandlingMode();
 	void EnableFpExceptions();
 
+	//RTA: which arithmetic translated code computes with. Translated code does its
+	//single-precision arithmetic with the host processor's own instructions, in the
+	//state the machine's thread has put the processor in.
+	//  ARITHMETIC_NATIVE   Play!'s own, the default: results rounded toward zero (as the
+	//                      console does), tiny (denormal) results and operands taken as zero.
+	//  ARITHMETIC_BROWSER  what the WebAssembly build of this core computes, where neither
+	//                      can be chosen: results rounded to nearest, denormals kept.
+	//                      A machine in this state computes the same bits as a browser
+	//                      machine (docs/issues/mixed-arithmetic.md in the game's repository).
+	//SetArithmetic may be called from any thread, at any time; the machine's thread puts
+	//its processor state in line when it starts and at every vertical blank.
+#define FPUTILS_HAS_ARITHMETIC 1
+	enum ARITHMETIC
+	{
+		ARITHMETIC_NATIVE = 0,
+		ARITHMETIC_BROWSER = 1,
+	};
+	void SetArithmetic(ARITHMETIC);
+	ARITHMETIC GetArithmetic();
+	//The arithmetic the calling thread's processor state gives right now
+	//(ARITHMETIC_BROWSER in a WebAssembly build, always).
+	ARITHMETIC GetThreadArithmetic();
+	//On the machine's thread. Returns true when the state had to be changed.
+	bool ApplyThreadArithmetic();
+
 	void IsZero(CMipsJitter*, size_t);
 	void IsNaN(CMipsJitter*, size_t);
 	void AssertIsNotNaN(CMipsJitter*, size_t);
