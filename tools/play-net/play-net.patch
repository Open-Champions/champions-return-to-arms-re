+bool CGSH_OpenGL::WantsSmoothTexture(uint64 primReg, uint64 tex1Reg, uint64 testReg) const
+{
+	if((m_fbScale <= 1) || !g_upscaleSmooth) return false;
+	auto prim = make_convertible<PRMODE>(primReg);
+	if(!prim.nTexture) return false;
+	auto tex1 = make_convertible<TEX1>(tex1Reg);
+	if(tex1.nMagFilter != MAG_FILTER_NEAREST) return false;
+	if(m_primitiveType == PRIM_SPRITE)
+	{
+		auto test = make_convertible<TEST>(testReg);
+		if(!test.nDepthEnabled || (test.nDepthMethod == DEPTH_TEST_ALWAYS)) return false;
+	}
+	return true;
