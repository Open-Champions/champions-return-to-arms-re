+	if(!texture)
+	{
+		//The entry only watches the memory; the textures themselves are in m_contentTextures
+		m_textureCache.Insert(tex0, Framework::OpenGl::CTexture());
+		texture = m_textureCache.Search(tex0);
+		texture->m_cachedArea.Invalidate(0, RAMSIZE);
+	}
+
+	CONTENT_TEXTURE_KEY key;
+	key.psm = tex0.nPsm;
+	key.width = texWidth;
+	key.height = texHeight;
+
+	if(texture->m_hasContentHash && !texture->m_cachedArea.HasDirtyPages() && (texture->m_contentWidth == texWidth) && (texture->m_contentHeight == texHeight))
+	{
+		//Nothing was written here since the last look
+		key.hash = texture->m_contentHash;
+		auto contentTextureIterator = m_contentTextures.find(key);
+		if(contentTextureIterator != std::end(m_contentTextures))
+		{
+			contentTextureIterator->second.lastUsedFrame = m_contentTextureFrame;
+			texInfo.textureHandle = contentTextureIterator->second.handle;
+			m_lastContentTexture = &contentTextureIterator->second;
+			m_lastContentKey = key;
+			return texInfo;
+		}
+	}
+
+	//The figure for the contents. GS memory is made of blocks of 256 bytes, each holding
+	//16 x 16 texels of an 8-bit texture or 32 x 16 of a 4-bit one, in an order of their
+	//own. For textures made of whole blocks the blocks are gathered as they are, which
+	//costs less than putting the texels in order; other textures are converted first.
+	//(The two ways give different figures for the same picture, but a texture of a given
+	//format and size always goes the same way.)
+	bool converted = false;
+	size_t byteCount = 0;
+	if((tex0.nPsm == PSMT8) && ((texWidth % 16) == 0) && ((texHeight % 16) == 0))
+	{
+		CGsPixelFormats::CPixelIndexorPSMT8 indexor(m_pRAM, tex0.GetBufPtr(), tex0.nBufWidth);
+		uint8* dst = m_pCvtBuffer;
+		for(unsigned int y = 0; y < texHeight; y += 16)
+		{
+			for(unsigned int x = 0; x < texWidth; x += 16)
+			{
+				memcpy(dst, indexor.GetPixelAddress(x, y), 256);
+				dst += 256;
+			}
+		}
+		byteCount = dst - m_pCvtBuffer;
+	}
+	else if((tex0.nPsm == PSMT4) && ((texWidth % 32) == 0) && ((texHeight % 16) == 0))
+	{
+		CGsPixelFormats::CPixelIndexorPSMT4 indexor(m_pRAM, tex0.GetBufPtr(), tex0.nBufWidth);
+		uint8* dst = m_pCvtBuffer;
+		for(unsigned int y = 0; y < texHeight; y += 16)
+		{
+			for(unsigned int x = 0; x < texWidth; x += 32)
+			{
+				//GetColumnAddress changes its arguments
+				unsigned int nx = x;
+				unsigned int ny = y;
+				memcpy(dst, m_pRAM + indexor.GetColumnAddress(nx, ny), 256);
+				dst += 256;
+			}
+		}
+		byteCount = dst - m_pCvtBuffer;
+	}
+	else
+	{
+		//Convert the whole texture into m_pCvtBuffer without uploading
+		ConvertTexture(tex0, texWidth, texHeight);
+		converted = true;
+		size_t texelSize = CGsPixelFormats::IsPsmIDTEX(tex0.nPsm) ? 1 : (((tex0.nPsm == PSMCT16) || (tex0.nPsm == PSMCT16S)) ? 2 : 4);
+		byteCount = static_cast<size_t>(texWidth) * texHeight * texelSize;
+	}
+	key.hash = XXH3_64bits(m_pCvtBuffer, byteCount);
+	g_textureCounters.memoryHashed++;
+	texture->m_cachedArea.ClearDirtyPages();
+	texture->m_contentHash = key.hash;
+	texture->m_contentWidth = texWidth;
+	texture->m_contentHeight = texHeight;
+	texture->m_hasContentHash = true;
+
+	auto contentTextureIterator = m_contentTextures.find(key);
+	if(contentTextureIterator == std::end(m_contentTextures))
+	{
+		if(!converted)
+		{
+			ConvertTexture(tex0, texWidth, texHeight);
+		}
+		if(auto log = TextureLog())
+		{
+			auto uploadIterator = m_uploads.find(tex0.GetBufPtr());
+			bool known = (uploadIterator != std::end(m_uploads)) && (uploadIterator->second.serial != 0);
+			fprintf(log, "%u memory %016llx p%u %ux%u named %ux%u at %06x bufwidth %u upload %s p%u bufwidth %u pieces %zu intact %d\n", m_contentTextureFrame, static_cast<unsigned long long>(key.hash), tex0.nPsm, texWidth, texHeight,
+			        static_cast<unsigned int>(tex0.GetWidth()), static_cast<unsigned int>(tex0.GetHeight()), tex0.GetBufPtr(), static_cast<unsigned int>(tex0.nBufWidth), known ? "known" : "unknown",
+			        known ? uploadIterator->second.psm : 0, known ? uploadIterator->second.bufWidth : 0, known ? uploadIterator->second.pieces.size() : size_t(0), known ? (IsUploadIntact(uploadIterator->second, tex0.GetBufPtr()) ? 1 : 0) : 0);
+			if(known)
+			{
+				fprintf(log, "   pieces");
+				for(const auto& piece : uploadIterator->second.pieces) fprintf(log, " %u,%u+%ux%u", piece.x, piece.y, piece.width, piece.height);
+				fprintf(log, "\n");
+			}
+		}
+		FinishContentTexture(tex0, key, texWidth, texHeight, nullptr, texInfo);
+		return texInfo;
+	}
+	contentTextureIterator->second.lastUsedFrame = m_contentTextureFrame;
+	texInfo.textureHandle = contentTextureIterator->second.handle;
+	m_lastContentTexture = &contentTextureIterator->second;
+	m_lastContentKey = key;
+	return texInfo;
+}
+
+//RTA: makes the texture for 'key' from the texels in m_pCvtBuffer (as the updaters leave
+//them) and gives it to the draw. 'coverage', when given, has a byte per texel: 0 where
+//the game sent nothing; those texels are made 0.
+void CGSH_OpenGL::FinishContentTexture(const TEX0& tex0, const CONTENT_TEXTURE_KEY& key, uint32 texWidth, uint32 texHeight, const std::vector<uint8>* coverage, TEXTURE_INFO& texInfo)
+{
+	size_t pixelSize = CGsPixelFormats::IsPsmIDTEX(tex0.nPsm) ? 1 : (((tex0.nPsm == PSMCT16) || (tex0.nPsm == PSMCT16S)) ? 2 : 4);
+	size_t pixelCount = static_cast<size_t>(texWidth) * texHeight;
+	if(coverage)
+	{
+		uint8* texels = m_pCvtBuffer;
+		for(size_t i = 0; i < pixelCount; i++)
+		{
+			if((*coverage)[i] == 0) memset(texels + (i * pixelSize), 0, pixelSize);
+		}
+	}
+	auto texFormat = GetTextureFormatInfo(tex0.nPsm);
+	CONTENT_TEXTURE contentTexture;
+	contentTexture.handle = Framework::OpenGl::CTexture::Create();
+	glBindTexture(GL_TEXTURE_2D, contentTexture.handle);
+	glTexStorage2D(GL_TEXTURE_2D, 1, texFormat.internalFormat, texWidth, texHeight);
+	glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, texWidth, texHeight, texFormat.format, texFormat.type, m_pCvtBuffer);
+	CHECKGLERROR();
+	if(g_textureDump || g_textureLoad)
+	{
+		contentTexture.pixels.assign(m_pCvtBuffer, m_pCvtBuffer + (pixelCount * pixelSize));
+		if(coverage) contentTexture.coverage = *coverage;
+	}
+	contentTexture.lastUsedFrame = m_contentTextureFrame;
+	auto contentTextureIterator = m_contentTextures.emplace(key, std::move(contentTexture)).first;
+	g_textureCounters.created++;
+	g_textureCounters.alive = m_contentTextures.size();
+	texInfo.textureHandle = contentTextureIterator->second.handle;
+	m_lastContentTexture = &contentTextureIterator->second;
+	m_lastContentKey = key;
+}
+
+//RTA: What the game sends, remembered (see UPLOAD_RECORD).
+
+CGSH_OpenGL::TEXTURE_COUNTERS CGSH_OpenGL::g_textureCounters;
+std::atomic<int> CGSH_OpenGL::g_textureMode{0};
+uint32 CGSH_OpenGL::g_textureDumpAge = 30;
+
+namespace
+{
+
+	//Calls f(block) for every 256-byte block of GS memory that the rectangle touches, in
+	//the given storage format
+	template <typename Storage, typename Function>
+	void ForEachBlock(uint32 basePtr, uint32 bufWidth, uint32 x, uint32 y, uint32 width, uint32 height, const Function& f)
+	{
+		if((width == 0) || (height == 0)) return;
+		uint32 pagesPerRow = (bufWidth * 64) / Storage::PAGEWIDTH;
+		for(uint32 by = (y / Storage::BLOCKHEIGHT); by <= ((y + height - 1) / Storage::BLOCKHEIGHT); by++)
+		{
+			for(uint32 bx = (x / Storage::BLOCKWIDTH); bx <= ((x + width - 1) / Storage::BLOCKWIDTH); bx++)
+			{
+				uint32 px = bx * Storage::BLOCKWIDTH;
+				uint32 py = by * Storage::BLOCKHEIGHT;
+				uint32 page = (px / Storage::PAGEWIDTH) + ((py / Storage::PAGEHEIGHT) * pagesPerRow);
+				uint32 block = Storage::m_nBlockSwizzleTable[(py % Storage::PAGEHEIGHT) / Storage::BLOCKHEIGHT][(px % Storage::PAGEWIDTH) / Storage::BLOCKWIDTH];
+				uint32 address = (basePtr + (page * CGsPixelFormats::PAGESIZE) + (block * CGsPixelFormats::BLOCKSIZE)) & (CGSHandler::RAMSIZE - 1);
+				f(address / CGsPixelFormats::BLOCKSIZE);
+			}
+		}
+	}
+
+	template <typename Function>
+	bool ForEachBlockOfPsm(uint32 psm, uint32 basePtr, uint32 bufWidth, uint32 x, uint32 y, uint32 width, uint32 height, const Function& f)
+	{
+		switch(psm)
+		{
+		case CGSHandler::PSMCT32:
+		case CGSHandler::PSMCT24:
+		case CGSHandler::PSMT8H:
+		case CGSHandler::PSMT4HL:
+		case CGSHandler::PSMT4HH:
+			ForEachBlock<CGsPixelFormats::STORAGEPSMCT32>(basePtr, bufWidth, x, y, width, height, f);
+			return true;
+		case CGSHandler::PSMCT16:
+			ForEachBlock<CGsPixelFormats::STORAGEPSMCT16>(basePtr, bufWidth, x, y, width, height, f);
+			return true;
+		case CGSHandler::PSMCT16S:
+			ForEachBlock<CGsPixelFormats::STORAGEPSMCT16S>(basePtr, bufWidth, x, y, width, height, f);
+			return true;
+		case CGSHandler::PSMT8:
+			ForEachBlock<CGsPixelFormats::STORAGEPSMT8>(basePtr, bufWidth, x, y, width, height, f);
+			return true;
+		case CGSHandler::PSMT4:
+			ForEachBlock<CGsPixelFormats::STORAGEPSMT4>(basePtr, bufWidth, x, y, width, height, f);
+			return true;
+		default:
+			return false;
+		}
+	}
+}
+
+void CGSH_OpenGL::BeginTransferWrite()
+{
+	CGSHandler::BeginTransferWrite();
+	if(!m_uploadHashState) m_uploadHashState = XXH3_createState();
+	XXH3_64bits_reset(static_cast<XXH3_state_t*>(m_uploadHashState));
+}
+
+void CGSH_OpenGL::TransferWrite(const uint8* imageData, uint32 length)
+{
+	if(m_uploadHashState) XXH3_64bits_update(static_cast<XXH3_state_t*>(m_uploadHashState), imageData, length);
+	CGSHandler::TransferWrite(imageData, length);
+}
+
+void CGSH_OpenGL::ForgetUploads()
+{
+	if(m_uploadHashState)
+	{
+		XXH3_freeState(static_cast<XXH3_state_t*>(m_uploadHashState));
+		m_uploadHashState = nullptr;
+	}
+	m_uploads.clear();
+	m_blockOwner.assign(RAMSIZE / CGsPixelFormats::BLOCKSIZE, 0);
+	m_transferCounter++;
+}
+
+//Something else than an upload wrote here
+void CGSH_OpenGL::ForgetUploadsInRange(uint32 address, uint32 size)
+{
+	if(m_blockOwner.empty()) return;
+	m_transferCounter++;
+	uint32 first = address / CGsPixelFormats::BLOCKSIZE;
+	uint32 last = (address + size + CGsPixelFormats::BLOCKSIZE - 1) / CGsPixelFormats::BLOCKSIZE;
+	for(uint32 block = first; block < last; block++) m_blockOwner[block % m_blockOwner.size()] = 0;
+}
+
+void CGSH_OpenGL::MarkUploadBlocks(const UPLOAD_RECORD& record, uint32 basePtr, const UPLOAD_PIECE& piece)
+{
+	uint32 serial = record.serial;
+	ForEachBlockOfPsm(record.psm, basePtr, record.bufWidth, piece.x, piece.y, piece.width, piece.height, [&](uint32 block) { m_blockOwner[block] = serial; });
+}
+
+//True while every block the upload wrote is as it left it
+bool CGSH_OpenGL::IsUploadIntact(UPLOAD_RECORD& record, uint32 basePtr)
+{
+	if(record.checkedAt == m_transferCounter) return record.intact;
+	bool intact = (record.serial != 0);
+	for(const auto& piece : record.pieces)
+	{
+		if(!intact) break;
+		intact = ForEachBlockOfPsm(record.psm, basePtr, record.bufWidth, piece.x, piece.y, piece.width, piece.height, [&](uint32 block) { intact = intact && (m_blockOwner[block] == record.serial); }) && intact;
+	}
+	record.checkedAt = m_transferCounter;
+	record.intact = intact;
+	return intact;
+}
+
+//At the end of every transfer from the game, whether it changed GS memory or not
+void CGSH_OpenGL::RecordUpload(const BITBLTBUF& bltBuf, const TRXREG& trxReg, const TRXPOS& trxPos, uint32 transferAddress, uint32 transferSize)
+{
+	if(m_blockOwner.empty()) m_blockOwner.assign(RAMSIZE / CGsPixelFormats::BLOCKSIZE, 0);
+	g_textureCounters.uploads++;
+	uint64 digest = m_uploadHashState ? XXH3_64bits_digest(static_cast<XXH3_state_t*>(m_uploadHashState)) : 0;
+
+	uint32 basePtr = bltBuf.GetDstPtr();
+	auto& record = m_uploads[basePtr];
+	UPLOAD_PIECE piece;
+	piece.x = trxPos.nDSAX;
+	piece.y = trxPos.nDSAY;
+	piece.width = trxReg.nRRW;
+	piece.height = trxReg.nRRH;
+
+	//A further piece of the picture that is there, or another picture? Another one when
+	//it writes over a piece already sent (a picture sent again starts with its first
+	//piece), when the format differs, or when something else has written there since.
+	bool further = (record.serial != 0) && (record.psm == bltBuf.nDstPsm) && (record.bufWidth == bltBuf.nDstWidth) && (record.pieces.size() < 256);
+	if(further)
+	{
+		for(const auto& other : record.pieces)
+		{
+			bool apart = ((piece.x + piece.width) <= other.x) || ((other.x + other.width) <= piece.x) || ((piece.y + piece.height) <= other.y) || ((other.y + other.height) <= piece.y);
+			if(!apart)
+			{
+				further = false;
+				break;
+			}
+		}
+	}
+	if(further) further = IsUploadIntact(record, basePtr);
+	if(!further)
+	{
+		record = UPLOAD_RECORD();
+		record.serial = ++m_uploadSerial;
+		record.psm = bltBuf.nDstPsm;
+		record.bufWidth = bltBuf.nDstWidth;
+	}
+	m_transferCounter++;
+
+	record.pieces.push_back(piece);
+	uint64 words[5] = {record.hash, (static_cast<uint64>(piece.y) << 32) | piece.x, (static_cast<uint64>(piece.height) << 32) | piece.width, digest, (static_cast<uint64>(record.bufWidth) << 32) | record.psm};
+	record.hash = XXH3_64bits(words, sizeof(words));
+	record.extent = std::max(record.extent, (transferAddress + transferSize) - basePtr);
+	record.width = std::max<uint32>(record.width, piece.x + piece.width);
+	record.height = std::max<uint32>(record.height, piece.y + piece.height);
+	record.checkedAt = 0;
+	MarkUploadBlocks(record, basePtr, piece);
+}
+
+//The upload the texture of a draw is made of, when it is known and still whole
+CGSH_OpenGL::UPLOAD_RECORD* CGSH_OpenGL::FindUpload(const TEX0& tex0)
+{
+	auto uploadIterator = m_uploads.find(tex0.GetBufPtr());
+	if(uploadIterator == std::end(m_uploads)) return nullptr;
+	auto& record = uploadIterator->second;
+	if((record.serial == 0) || record.pieces.empty()) return nullptr;
+	if(!IsUploadIntact(record, tex0.GetBufPtr())) return nullptr;
+	return &record;
+}
+
+namespace
+{
+	//Writes 'value' (all ones or zero) to every pixel of a rectangle in a format
+	template <typename Storage>
+	void FillPixels(uint8* memory, uint32 basePtr, uint32 bufWidth, uint32 x0, uint32 y0, uint32 width, uint32 height, bool set)
+	{
+		CGsPixelFormats::CPixelIndexor<Storage> indexor(memory, basePtr, bufWidth);
+		auto value = static_cast<typename Storage::Unit>(set ? ~static_cast<typename Storage::Unit>(0) : 0);
+		for(uint32 y = y0; y < (y0 + height); y++)
+		{
+			for(uint32 x = x0; x < (x0 + width); x++) indexor.SetPixel(x, y, value);
+		}
+	}
+
+	bool FillPixelsOfPsm(uint32 psm, uint8* memory, uint32 basePtr, uint32 bufWidth, uint32 x, uint32 y, uint32 width, uint32 height, bool set)
+	{
+		switch(psm)
+		{
+		case CGSHandler::PSMCT32:
+		case CGSHandler::PSMCT24:
+		case CGSHandler::PSMT8H:
+		case CGSHandler::PSMT4HL:
+		case CGSHandler::PSMT4HH:
+			FillPixels<CGsPixelFormats::STORAGEPSMCT32>(memory, basePtr, bufWidth, x, y, width, height, set);
+			return true;
+		case CGSHandler::PSMCT16:
+			FillPixels<CGsPixelFormats::STORAGEPSMCT16>(memory, basePtr, bufWidth, x, y, width, height, set);
+			return true;
+		case CGSHandler::PSMCT16S:
+			FillPixels<CGsPixelFormats::STORAGEPSMCT16S>(memory, basePtr, bufWidth, x, y, width, height, set);
+			return true;
+		case CGSHandler::PSMT8:
+			FillPixels<CGsPixelFormats::STORAGEPSMT8>(memory, basePtr, bufWidth, x, y, width, height, set);
+			return true;
+		case CGSHandler::PSMT4:
+			FillPixels<CGsPixelFormats::STORAGEPSMT4>(memory, basePtr, bufWidth, x, y, width, height, set);
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	//Reads a rectangle of a texture: 1 for every texel that is not zero. Also gives the
+	//size of the smallest rectangle from the corner that holds all of those.
+	template <typename Storage>
+	void ReadCoverage(uint8* memory, uint32 basePtr, uint32 bufWidth, uint32 width, uint32 height, uint8* coverage, uint32& usedWidth, uint32& usedHeight)
+	{
+		CGsPixelFormats::CPixelIndexor<Storage> indexor(memory, basePtr, bufWidth);
+		usedWidth = usedHeight = 0;
+		for(uint32 y = 0; y < height; y++)
+		{
+			for(uint32 x = 0; x < width; x++)
+			{
+				bool covered = (indexor.GetPixel(x, y) != 0);
+				coverage[(static_cast<size_t>(y) * width) + x] = covered ? 1 : 0;
+				if(covered)
+				{
+					usedWidth = std::max(usedWidth, x + 1);
+					usedHeight = y + 1;
+				}
+			}
+		}
+	}
+
+	bool ReadCoverageOfPsm(uint32 psm, uint8* memory, uint32 basePtr, uint32 bufWidth, uint32 width, uint32 height, uint8* coverage, uint32& usedWidth, uint32& usedHeight)
+	{
+		switch(psm)
+		{
+		case CGSHandler::PSMCT32:
+		case CGSHandler::PSMCT24:
+		case CGSHandler::PSMT8H:
+		case CGSHandler::PSMT4HL:
+		case CGSHandler::PSMT4HH:
+			ReadCoverage<CGsPixelFormats::STORAGEPSMCT32>(memory, basePtr, bufWidth, width, height, coverage, usedWidth, usedHeight);
+			return true;
+		case CGSHandler::PSMCT16:
+			ReadCoverage<CGsPixelFormats::STORAGEPSMCT16>(memory, basePtr, bufWidth, width, height, coverage, usedWidth, usedHeight);
+			return true;
+		case CGSHandler::PSMCT16S:
+			ReadCoverage<CGsPixelFormats::STORAGEPSMCT16S>(memory, basePtr, bufWidth, width, height, coverage, usedWidth, usedHeight);
+			return true;
+		case CGSHandler::PSMT8:
+			ReadCoverage<CGsPixelFormats::STORAGEPSMT8>(memory, basePtr, bufWidth, width, height, coverage, usedWidth, usedHeight);
+			return true;
+		case CGSHandler::PSMT4:
+			ReadCoverage<CGsPixelFormats::STORAGEPSMT4>(memory, basePtr, bufWidth, width, height, coverage, usedWidth, usedHeight);
+			return true;
+		default:
+			return false;
+		}
+	}
+}
+
+//Which texels of a texture the pieces of an upload wrote: a byte per texel of the
+//rectangle looked at (the size TEX0 names, or less when the blocks beyond are not the
+//upload's), and the smallest rectangle from the corner that holds them all.
+//
+//The game sends 8-bit textures as 32-bit pixels, in rectangles of any height: a line of
+//32-bit pixels is two lines of 8-bit texels that are not next to each other. So this is
+//not worked out but done: the pieces are written, all ones, into a second GS memory in
+//the format they were sent in, and read back in the texture's format - with the same
+//code that reads the texture itself.
+bool CGSH_OpenGL::GetUploadCoverage(const TEX0& tex0, const UPLOAD_RECORD& record, std::vector<uint8>& coverage, uint32& lookedWidth, uint32& lookedHeight, uint32& usedWidth, uint32& usedHeight)
+{
+	uint32 basePtr = tex0.GetBufPtr();
+	uint32 texWidth = std::min<uint32>(tex0.GetWidth(), TEX0_MAX_TEXTURE_SIZE);
+	uint32 texHeight = std::min<uint32>(tex0.GetHeight(), TEX0_MAX_TEXTURE_SIZE);
+
+	//how far the upload's blocks reach in the texture
+	uint32 blockWidth = 0, blockHeight = 0;
+	switch(tex0.nPsm)
+	{
+	case PSMT8:
+		blockWidth = CGsPixelFormats::STORAGEPSMT8::BLOCKWIDTH, blockHeight = CGsPixelFormats::STORAGEPSMT8::BLOCKHEIGHT;
+		break;
+	case PSMT4:
+		blockWidth = CGsPixelFormats::STORAGEPSMT4::BLOCKWIDTH, blockHeight = CGsPixelFormats::STORAGEPSMT4::BLOCKHEIGHT;
+		break;
+	case PSMCT16:
+	case PSMCT16S:
+		blockWidth = CGsPixelFormats::STORAGEPSMCT16::BLOCKWIDTH, blockHeight = CGsPixelFormats::STORAGEPSMCT16::BLOCKHEIGHT;
+		break;
+	default:
+		blockWidth = CGsPixelFormats::STORAGEPSMCT32::BLOCKWIDTH, blockHeight = CGsPixelFormats::STORAGEPSMCT32::BLOCKHEIGHT;
+		break;
+	}
+	lookedWidth = lookedHeight = 0;
+	for(uint32 y = 0; y < texHeight; y += blockHeight)
+	{
+		for(uint32 x = 0; x < texWidth; x += blockWidth)
+		{
+			bool own = false;
+			if(!ForEachBlockOfPsm(tex0.nPsm, basePtr, tex0.nBufWidth, x, y, 1, 1, [&](uint32 block) { own = (m_blockOwner[block] == record.serial); })) return false;
+			if(own)
+			{
+				lookedWidth = std::max(lookedWidth, std::min(x + blockWidth, texWidth));
+				lookedHeight = std::min(y + blockHeight, texHeight);
+			}
+		}
+	}
+	if((lookedWidth == 0) || (lookedHeight == 0)) return false;
+
+	if(m_uploadShadow.empty()) m_uploadShadow.assign(RAMSIZE, 0);
+	for(const auto& piece : record.pieces)
+	{
+		if(!FillPixelsOfPsm(record.psm, m_uploadShadow.data(), basePtr, record.bufWidth, piece.x, piece.y, piece.width, piece.height, true)) return false;
+	}
+	coverage.resize(static_cast<size_t>(lookedWidth) * lookedHeight);
+	bool read = ReadCoverageOfPsm(tex0.nPsm, m_uploadShadow.data(), basePtr, tex0.nBufWidth, lookedWidth, lookedHeight, coverage.data(), usedWidth, usedHeight);
+	for(const auto& piece : record.pieces)
+	{
+		FillPixelsOfPsm(record.psm, m_uploadShadow.data(), basePtr, record.bufWidth, piece.x, piece.y, piece.width, piece.height, false);
+	}
+	return read && (usedWidth != 0) && (usedHeight != 0);
+}
+
+//RTA: Textures kept by what the game sent.
+//
+//The figure that names the texture is the one of the bytes sent (and where each piece
+//went), taken while they arrived: nothing is read or converted when a texture that was
+//sent again is drawn with, and the name is the same wherever in GS memory the game puts
+//the texture and in every run. Texels the game did not send are 0 in the texture made
+//(they are whatever lay there before on a console; no triangle is meant to use them).
+bool CGSH_OpenGL::PrepareTextureByUpload(const TEX0& tex0, UPLOAD_RECORD& record, TEXTURE_INFO& texInfo)
+{
+	uint32 namedWidth = std::min<uint32>(tex0.GetWidth(), TEX0_MAX_TEXTURE_SIZE);
+	uint32 namedHeight = std::min<uint32>(tex0.GetHeight(), TEX0_MAX_TEXTURE_SIZE);
+
+	//The rectangle that holds what was sent. One piece from the corner in the texture's
+	//own format is that rectangle; anything else is looked up, or worked out once.
+	bool plain = (record.pieces.size() == 1) && (record.psm == tex0.nPsm) && (record.bufWidth == tex0.nBufWidth) && (record.pieces[0].x == 0) && (record.pieces[0].y == 0);
+	uint32 usedWidth = 0, usedHeight = 0;
+	uint64 hash = record.hash;
+	std::vector<uint8> coverage;
+	uint32 lookedWidth = 0, lookedHeight = 0;
+	if(plain)
+	{
+		usedWidth = std::min<uint32>(record.pieces[0].width, namedWidth);
+		usedHeight = std::min<uint32>(record.pieces[0].height, namedHeight);
+	}
+	else
+	{
+		//the same bytes read as another format are another picture
+		uint64 words[2] = {record.hash, (static_cast<uint64>(tex0.nBufWidth) << 32) | tex0.nPsm};
+		bool natural = ((record.psm == tex0.nPsm) && (record.bufWidth == tex0.nBufWidth)) || ((tex0.nPsm == PSMT8) && (record.psm == PSMCT32) && ((record.bufWidth * 2) == tex0.nBufWidth));
+		if(!natural) hash = XXH3_64bits(words, sizeof(words));
+		uint64 boxKey = natural ? XXH3_64bits(words, sizeof(words)) : hash;
+		auto boxIterator = m_uploadBoxes.find(boxKey);
+		if(boxIterator == std::end(m_uploadBoxes))
+		{
+			if(!GetUploadCoverage(tex0, record, coverage, lookedWidth, lookedHeight, usedWidth, usedHeight)) return false;
+			if(m_uploadBoxes.size() > 65536) m_uploadBoxes.clear();
+			m_uploadBoxes.emplace(boxKey, std::make_pair(usedWidth, usedHeight));
+		}
+		else
+		{
+			usedWidth = boxIterator->second.first;
+			usedHeight = boxIterator->second.second;
+		}
+	}
+
+	uint32 texWidth = m_texAllowReducedSize ? usedWidth : namedWidth;
+	uint32 texHeight = m_texAllowReducedSize ? usedHeight : namedHeight;
+	//large pictures in direct colour are left to the path that updates in place
+	if(!CGsPixelFormats::IsPsmIDTEX(tex0.nPsm) && ((texWidth * texHeight) > (512 * 512))) return false;
+
+	texInfo.sizeScaleX = static_cast<float>(texWidth) / static_cast<float>(tex0.GetWidth());
+	texInfo.sizeScaleY = static_cast<float>(texHeight) / static_cast<float>(tex0.GetHeight());
+	texInfo.scaleRatioX = 1.0f / texInfo.sizeScaleX;
+	texInfo.scaleRatioY = 1.0f / texInfo.sizeScaleY;
+
+	CONTENT_TEXTURE_KEY key;
+	key.psm = tex0.nPsm;
+	key.width = texWidth;
+	key.height = texHeight;
+	key.kind = 1;
+	key.hash = hash;
+	g_textureCounters.byUpload++;
+
+	auto contentTextureIterator = m_contentTextures.find(key);
+	if(contentTextureIterator != std::end(m_contentTextures))
+	{
+		contentTextureIterator->second.lastUsedFrame = m_contentTextureFrame;
+		texInfo.textureHandle = contentTextureIterator->second.handle;
+		m_lastContentTexture = &contentTextureIterator->second;
+		m_lastContentKey = key;
+		return true;
+	}
+
+	//Not seen before (or forgotten): which texels were sent
+	std::vector<uint8> texCoverage;
+	bool whole = plain;
+	if(!plain)
+	{
+		if(coverage.empty() && !GetUploadCoverage(tex0, record, coverage, lookedWidth, lookedHeight, usedWidth, usedHeight))
+		{
+			g_textureCounters.byUpload--;
+			return false;
+		}
+		texCoverage.assign(static_cast<size_t>(texWidth) * texHeight, 0);
+		size_t covered = 0;
+		uint32 copyWidth = std::min(texWidth, lookedWidth);
+		for(uint32 y = 0; y < std::min(texHeight, lookedHeight); y++)
+		{
+			const uint8* src = coverage.data() + (static_cast<size_t>(y) * lookedWidth);
+			uint8* dst = texCoverage.data() + (static_cast<size_t>(y) * texWidth);
+			memcpy(dst, src, copyWidth);
+			for(uint32 x = 0; x < copyWidth; x++) covered += src[x];
+		}
+		whole = (covered == texCoverage.size());
+	}
+
+	//the texels are taken from GS memory, where the upload put them
+	ConvertTexture(tex0, texWidth, texHeight);
+
+	if(auto log = TextureLog())
+	{
+		fprintf(log, "%u sent %016llx p%u %ux%u named %ux%u at %06x pieces %zu sent-as p%u whole %d\n", m_contentTextureFrame, static_cast<unsigned long long>(key.hash), tex0.nPsm, texWidth, texHeight,
+		        static_cast<unsigned int>(tex0.GetWidth()), static_cast<unsigned int>(tex0.GetHeight()), tex0.GetBufPtr(), record.pieces.size(), record.psm, whole ? 1 : 0);
+	}
+	FinishContentTexture(tex0, key, texWidth, texHeight, whole ? nullptr : &texCoverage, texInfo);
+	return true;
+}
+
+//RTA: see TEXTURE_PICTURE_KEY. Returns the texture to draw with in place of the one
+//PrepareTextureByUpload or PrepareTextureByContent gave, or 0. Indexed textures and
+//32-bit ones only.
+GLuint CGSH_OpenGL::FindTextureReplacement(const TEX0& tex0)
+{
+	if(!m_lastContentTexture || m_lastContentTexture->pixels.empty()) return 0;
+	bool indexed = CGsPixelFormats::IsPsmIDTEX(tex0.nPsm);
+	if(!indexed && (tex0.nPsm != PSMCT32)) return 0;
+
+	TEXTURE_PICTURE_KEY key;
+	key.psm = m_lastContentKey.psm;
+	key.width = m_lastContentKey.width;
+	key.height = m_lastContentKey.height;
+	key.kind = m_lastContentKey.kind;
+	key.hash = m_lastContentKey.hash;
+
+	std::array<uint32, 256> clut;
+	if(indexed)
+	{
+		MakeLinearCLUT(tex0, clut);
+		key.clutHash = XXH3_64bits(clut.data(), (CGsPixelFormats::IsPsmIDTEX4(tex0.nPsm) ? 16 : 256) * sizeof(uint32));
+	}
+
+	auto replacementIterator = m_textureReplacements.find(key);
+	if(replacementIterator == std::end(m_textureReplacements))
+	{
+		TEXTURE_PICTURE texturePicture;
+		texturePicture.firstUsedFrame = m_contentTextureFrame;
+		if(g_textureLoad)
+		{
+			std::vector<uint32> picture;
+			uint32 width = 0, height = 0;
+			if(g_textureLoad(key, picture, width, height) && (width != 0) && (height != 0) && (picture.size() >= (static_cast<size_t>(width) * height)))
+			{
+				texturePicture.replacement = Framework::OpenGl::CTexture::Create();
+				glBindTexture(GL_TEXTURE_2D, texturePicture.replacement);
+				glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, width, height);
+				glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, picture.data());
+				CHECKGLERROR();
+			}
+		}
+		replacementIterator = m_textureReplacements.emplace(key, std::move(texturePicture)).first;
+		g_textureCounters.shortLived++;
+	}
+	auto& texturePicture = replacementIterator->second;
+	//Written out once it has been in use for a while: a film is thousands of pictures
+	//that are each drawn for a frame or two, and nobody wants those.
+	if(!texturePicture.dumped && ((m_contentTextureFrame - texturePicture.firstUsedFrame) >= g_textureDumpAge))
+	{
+		texturePicture.dumped = true;
+		g_textureCounters.shortLived--;
+		if(g_textureDump)
+		{
+			size_t pixelCount = static_cast<size_t>(key.width) * key.height;
+			std::vector<uint32> picture(pixelCount);
+			const auto& pixels = m_lastContentTexture->pixels;
+			if(indexed)
+			{
+				uint32 mask = CGsPixelFormats::IsPsmIDTEX4(tex0.nPsm) ? 0x0F : 0xFF;
+				for(size_t i = 0; i < pixelCount; i++) picture[i] = clut[pixels[i] & mask];
+			}
+			else
+			{
+				memcpy(picture.data(), pixels.data(), pixelCount * sizeof(uint32));
+			}
+			//texels the game did not send: nothing at all (alpha 0 alone is a colour
+			//the game uses, see the README)
+			const auto& coverage = m_lastContentTexture->coverage;
+			if(coverage.size() == pixelCount)
+			{
+				for(size_t i = 0; i < pixelCount; i++)
+				{
+					if(coverage[i] == 0) picture[i] = 0;
+				}
+			}
+			g_textureDump(key, picture.data());
+		}
+	}
+	return texturePicture.replacement;
+}
+
+//Once a frame, when nothing is waiting to be drawn: forget textures not used for a while
+void CGSH_OpenGL::ContentTextures_EndFrame()
+{
+	m_contentTextureFrame++;
+	static const uint32 g_sweepInterval = 300;
+	static const uint32 g_maxAge = 1800;
+	static const size_t g_keepCount = 512;
+	if(((m_contentTextureFrame % g_sweepInterval) != 0) || (m_contentTextures.size() <= g_keepCount)) return;
+	for(auto contentTextureIterator = std::begin(m_contentTextures); contentTextureIterator != std::end(m_contentTextures);)
+	{
+		if((m_contentTextureFrame - contentTextureIterator->second.lastUsedFrame) > g_maxAge)
+		{
+			if(m_lastContentTexture == &contentTextureIterator->second) m_lastContentTexture = nullptr;
+			contentTextureIterator = m_contentTextures.erase(contentTextureIterator);
+		}
+		else
+		{
+			contentTextureIterator++;
+		}
+	}
+	g_textureCounters.alive = m_contentTextures.size();
+}
