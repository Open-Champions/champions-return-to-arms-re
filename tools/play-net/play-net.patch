@@ -1,39 +1,43 @@
 #pragma once
 
 #include <chrono>
+#include <functional>
 #include "Types.h"
 
-#ifdef _WIN32
-#include <Windows.h>
-#endif
-
+//RTA: rewritten. The original measured how long the last four frames took to compute and
+//slept for the rest of the frame time in steps of 250 microseconds. Every step that
+//overslept made the frame longer and nothing made up for it, so the machine ran a little
+//slow all the time (57.6 instead of 60 frames a second on a busy computer, measured), and
+//sound, which is played at its real rate, ran dry again and again. This one keeps a
+//deadline for every frame, one frame time after the last deadline: a frame that is late
+//is followed by shorter waits until the machine has caught up, so the average rate is
+//exact as long as the computer is fast enough.
 class CFrameLimiter
 {
 public:
-	CFrameLimiter();
-	~CFrameLimiter();
+	CFrameLimiter() = default;
+	~CFrameLimiter() = default;
 
 	void BeginFrame();
 	void EndFrame();
 
 	void SetFrameRate(uint32);
 
+	//A clock from outside, which the front end may provide: the display's own. Called
+	//with the frame rate where the wait would be; it waits for the moment the next
+	//frame should start and returns true, or returns false at once when it cannot give
+	//that rate (the timer below is used then).
+	typedef std::function<bool(uint32)> ExternalWaitFunction;
+	static void SetExternalWait(const ExternalWaitFunction&);
+
 private:
-	typedef std::chrono::high_resolution_clock::time_point TimePoint;
+	static ExternalWaitFunction m_externalWait;
+	uint32 m_frameRate = 0;
 
-	enum
-	{
-		MAX_FRAMETIMES = 4,
-	};
+	typedef std::chrono::steady_clock Clock;
 
-	std::chrono::microseconds m_frameTimes[MAX_FRAMETIMES];
-	uint32 m_frameTimeIndex = 0;
-
-	std::chrono::microseconds m_minFrameDuration = std::chrono::microseconds(0);
+	std::chrono::nanoseconds m_frameDuration = std::chrono::nanoseconds(0);
 	bool m_frameStarted = false;
-	TimePoint m_lastFrameTime;
-
-#ifdef _WIN32
-	HANDLE m_timer = 0;
-#endif
+	bool m_hasDeadline = false;
+	Clock::time_point m_deadline;
 };
