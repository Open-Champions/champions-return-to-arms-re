+void CGSH_OpenGLQt::RequestCapture(const CaptureHandler& captureHandler)
+{
+	RequestCapture(captureHandler, 0, 0, 0, 0);
+}
+
+void CGSH_OpenGLQt::RequestCapture(const CaptureHandler& captureHandler, unsigned int x, unsigned int y, unsigned int width, unsigned int height)
+{
+	std::lock_guard<std::mutex> lock(m_captureMutex);
+	m_captureHandler = captureHandler;
+	m_captureRect[0] = x;
+	m_captureRect[1] = y;
+	m_captureRect[2] = width;
+	m_captureRect[3] = height;
+}
+
+void CGSH_OpenGLQt::RequestFramebufferCapture(const CaptureHandler& captureHandler)
+{
+	std::lock_guard<std::mutex> lock(m_captureMutex);
+	m_captureHandler = captureHandler;
+	m_captureRect[2] = m_captureRect[3] = 0;
+	m_captureFramebuffer = true;
+}
+
 void CGSH_OpenGLQt::PresentBackbuffer()
 {
+	{
+		CaptureHandler captureHandler;
+		unsigned int x = 0, y = 0;
+		unsigned int width = m_presentationParams.windowWidth;
+		unsigned int height = m_presentationParams.windowHeight;
+		bool fromFramebuffer = false;
+		{
+			std::lock_guard<std::mutex> lock(m_captureMutex);
+			captureHandler.swap(m_captureHandler);
+			fromFramebuffer = m_captureFramebuffer;
+			m_captureFramebuffer = false;
+			if((m_captureRect[2] != 0) && (m_captureRect[3] != 0))
+			{
+				x = std::min(m_captureRect[0], width - 1);
+				y = std::min(m_captureRect[1], height - 1);
+				width = std::min(m_captureRect[2], width - x);
+				height = std::min(m_captureRect[3], height - y);
+			}
+		}
+		if(captureHandler && fromFramebuffer)
+		{
+			width = (m_displayFramebuffer != 0) ? m_displayPixelWidth : 0;
+			height = (m_displayFramebuffer != 0) ? m_displayPixelHeight : 0;
+			std::vector<uint8> pixels(static_cast<size_t>(width) * height * 4);
+			if(!pixels.empty())
+			{
+				glBindFramebuffer(GL_READ_FRAMEBUFFER, m_displayFramebuffer);
+				glPixelStorei(GL_PACK_ALIGNMENT, 1);
+				glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+				glBindFramebuffer(GL_READ_FRAMEBUFFER, m_presentFramebuffer);
+				//the console's alpha is not for looking at
+				for(size_t i = 3; i < pixels.size(); i += 4) pixels[i] = 0xFF;
+			}
+			captureHandler(pixels.data(), width, height);
+		}
+		else if(captureHandler)
+		{
+			std::vector<uint8> pixels(static_cast<size_t>(width) * height * 4);
+			if(!pixels.empty())
+			{
+				glBindFramebuffer(GL_READ_FRAMEBUFFER, m_presentFramebuffer);
+				glPixelStorei(GL_PACK_ALIGNMENT, 1);
+				glReadPixels(x, y, width, height, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+			}
+			captureHandler(pixels.data(), width, height);
+		}
+	}
 	bool swapBuffer = true;
 	if(m_renderSurface->surfaceClass() == QSurface::Window)
 	{
