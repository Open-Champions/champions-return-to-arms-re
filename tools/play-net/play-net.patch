+CGSH_OpenGL::TEXTURE_COUNTERS CGSH_OpenGL::g_textureCounters;
+std::atomic<int> CGSH_OpenGL::g_textureMode{0};
+uint32 CGSH_OpenGL::g_textureDumpAge = 30;
+std::atomic<bool> CGSH_OpenGL::g_textureReplaceOn{true};
+std::atomic<bool> CGSH_OpenGL::g_textureReplaceCrop{true};
+std::atomic<uint32> CGSH_OpenGL::g_textureReplaceReload{0};
+std::atomic<uint64> CGSH_OpenGL::g_textureReplaceBudget{3072ULL * 1024 * 1024};
