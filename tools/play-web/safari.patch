+uint128 CVuExecutor::GetProgramKey() const
+{
+	//The whole of program memory, as the translator reads it
+	XXH128_hash_t xxHash;
+	auto map = m_context.m_pMemoryMap->GetInstructionMap(0);
+	if(map && (map->nStart == 0) && (map->nEnd >= (m_maxAddress - 1)) && map->pPointer)
+	{
+		xxHash = XXH3_128bits(map->pPointer, m_maxAddress);
+	}
+	else
+	{
+		std::vector<uint32> words(m_maxAddress / 4);
+		for(uint32 address = 0; address < m_maxAddress; address += 4)
+		{
+			words[address / 4] = m_context.m_pMemoryMap->GetInstruction(address);
+		}
+		xxHash = XXH3_128bits(words.data(), words.size() * sizeof(uint32));
+	}
+	uint128 key;
+	memcpy(&key, &xxHash, sizeof(xxHash));
+	static_assert(sizeof(key) == sizeof(xxHash));
+	return key;
+}
+
+void CVuExecutor::SetFixedProgram(const BlockNoClampingSet& blockNoClamping)
+{
+	//This executor is made for program memory as it is now, and is only used while
+	//program memory is that: its flags policy is settled here, once
+	m_isFixedProgram = true;
+	m_flagsElision = true;
+	m_blockNoClamping = blockNoClamping;
+	m_skipStickyFlags = !HasStickyFlagReaders();
+	m_flagsPolicyPending = false;
+}
+
+void CVuExecutor::SelectProgram()
+{
+	m_flagsPolicyPending = false;
+	m_programKey = GetProgramKey();
+	auto programIterator = m_keptPrograms.find(m_programKey);
+	if(programIterator == std::end(m_keptPrograms))
+	{
+		if(m_keptPrograms.size() >= MAX_KEPT_PROGRAMS)
+		{
+			//The one that was in memory longest ago goes
+			auto oldestIterator = std::min_element(std::begin(m_keptPrograms), std::end(m_keptPrograms),
+			                                       [](const auto& item1, const auto& item2) { return item1.second.lastUse < item2.second.lastUse; });
+			m_keptPrograms.erase(oldestIterator);
+		}
+		KEPT_PROGRAM program;
+		//(the new executor installs its handler for "no block here" itself)
+		m_context.m_emptyBlockHandler = nullptr;
+		program.executor = std::make_unique<CVuExecutor>(m_context, m_maxAddress);
+		//(an executor's table of blocks is only set up by Reset)
+		program.executor->Reset();
+		program.executor->SetFixedProgram(m_blockNoClamping);
+		programIterator = m_keptPrograms.insert(std::make_pair(m_programKey, std::move(program))).first;
+		g_rtaWebVuProgramsMade++;
+	}
+	else
+	{
+		programIterator->second.executor->InstallEmptyBlockHandler();
+	}
+	programIterator->second.lastUse = ++m_programUse;
+	g_rtaWebVuProgramChanges++;
+	m_program = programIterator->second.executor.get();
+	bool skipStickyFlags = m_program->m_skipStickyFlags;
+	if(skipStickyFlags != m_skipStickyFlags)
+	{
+		m_skipStickyFlags = skipStickyFlags;
+		printf("VU: sticky sign and zero flags are %s (the program memory has %s that reads them).\r\n",
+		       skipStickyFlags ? "not kept" : "kept", skipStickyFlags ? "no instruction" : "an instruction");
+	}
+}
