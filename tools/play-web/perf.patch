+//RTA(web): A float instruction's MAC flags reach the flag register LATENCY_MAC cycles
+//after it, and an instruction that reads the flags (FMAND, FMEQ, FMOR, FSAND, FSEQ, FSOR)
+//sees those of the latest float instruction at least that far before it. The flags of
+//this block's last float instructions are therefore read by code after the block only
+//if, on some way on from the block, a reading instruction comes before a float
+//instruction has been LATENCY_MAC instructions ago. (Waits the processor inserts only
+//move a reader further from the instructions before it.) Where the way on is not known
+//here - the program ends or stops, a jump through a register, a branch that is not
+//followed by its delay slot in this block, too long a search - the answer is "yes",
+//which is what the code did for every block before.
+bool CVuBasicBlock::AreTrailingFlagsRead(uint32 maxAddress) const
+{
+	if((m_blockCompileHints & VUShared::COMPILEHINT_LOOKAHEAD_FLAGS) == 0) return true;
+	if(IsEmpty()) return true;
 
+	auto arch = static_cast<CMA_VU*>(m_context.m_pArch);
+	static const uint32 stopBits = VUShared::VU_UPPEROP_BIT_E | VUShared::VU_UPPEROP_BIT_D | VUShared::VU_UPPEROP_BIT_T;
+
+	for(uint32 address = m_begin; address <= m_end; address += 8)
+	{
+		uint32 opcodeHi = m_context.m_pMemoryMap->GetInstruction(address + 4);
+		if(opcodeHi & stopBits) return true;
+	}
+
+	//A branch in the last pair has its delay slot in another block
+	uint32 lastOpcodeLoAddr = m_end - 4;
+	uint32 lastOpcodeLo = m_context.m_pMemoryMap->GetInstruction(lastOpcodeLoAddr);
+	if(arch->IsInstructionBranch(&m_context, lastOpcodeLoAddr, lastOpcodeLo) != MIPS_BRANCH_NONE) return true;
+
+	uint32 budget = 48;
+	bool fallsThrough = true;
+	if((m_end - m_begin) >= 0xC)
+	{
+		uint32 branchOpcodeLoAddr = m_end - 0xC;
+		uint32 branchOpcodeLo = m_context.m_pMemoryMap->GetInstruction(branchOpcodeLoAddr);
+		auto branchType = arch->IsInstructionBranch(&m_context, branchOpcodeLoAddr, branchOpcodeLo);
+		if(branchType == MIPS_BRANCH_NORMAL)
+		{
+			uint32 target = arch->GetInstructionEffectiveAddress(&m_context, branchOpcodeLoAddr, branchOpcodeLo);
+			if(target == MIPS_INVALID_PC) return true;
+			if(IsFlagReaderExposed(target, -1, budget, 0, maxAddress)) return true;
+			uint32 id = (branchOpcodeLo >> 25) & 0x7F;
+			fallsThrough = !((id == 0x20) || (id == 0x21)); //B, BAL
+		}
+		else if(branchType != MIPS_BRANCH_NONE)
+		{
+			return true;
+		}
+	}
+	if(fallsThrough)
+	{
+		if(IsFlagReaderExposed(m_end + 4, -1, budget, 0, maxAddress)) return true;
+	}
+	return false;
+}
+
+//From 'address' on: is there a way to a flag-reading instruction that does not pass a
+//float instruction LATENCY_MAC or more instructions before it? writerAge: instructions
+//since the first float instruction on this way (-1: none yet).
+bool CVuBasicBlock::IsFlagReaderExposed(uint32 address, int32 writerAge, uint32& budget, uint32 depth, uint32 maxAddress) const
+{
+	auto arch = static_cast<CMA_VU*>(m_context.m_pArch);
+	static const uint32 stopBits = VUShared::VU_UPPEROP_BIT_E | VUShared::VU_UPPEROP_BIT_D | VUShared::VU_UPPEROP_BIT_T;
+	static const uint32 maxDepth = 6;
+
+	bool branchPending = false;
+	bool branchFallsThrough = false;
+	uint32 branchTarget = MIPS_INVALID_PC;
+
+	while(1)
+	{
+		if(writerAge >= static_cast<int32>(VUShared::LATENCY_MAC)) return false;
+		if((address + 8) > maxAddress) return true;
+		if(budget == 0) return true;
+		budget--;
+
+		uint32 opcodeLo = m_context.m_pMemoryMap->GetInstruction(address);
+		uint32 opcodeHi = m_context.m_pMemoryMap->GetInstruction(address + 4);
+		if(opcodeHi & stopBits) return true;
+
+		auto loOps = arch->GetAffectedOperands(&m_context, address, opcodeLo);
+		auto hiOps = arch->GetAffectedOperands(&m_context, address + 4, opcodeHi);
+		if(loOps.readMACflags) return true;
+
+		auto branchType = arch->IsInstructionBranch(&m_context, address, opcodeLo);
+
+		if(writerAge >= 0)
+		{
+			writerAge++;
+		}
+		else if(hiOps.writeMACflags)
+		{
+			writerAge = 1;
+		}
+
+		if(branchPending)
+		{
+			//This was the delay slot
+			if(branchType != MIPS_BRANCH_NONE) return true;
+			if(branchTarget == MIPS_INVALID_PC) return true;
+			if(depth >= maxDepth) return true;
+			if(IsFlagReaderExposed(branchTarget, writerAge, budget, depth + 1, maxAddress)) return true;
+			if(!branchFallsThrough) return false;
+			branchPending = false;
+		}
+		else if(branchType == MIPS_BRANCH_NORMAL)
+		{
+			uint32 id = (opcodeLo >> 25) & 0x7F;
+			branchPending = true;
+			branchTarget = arch->GetInstructionEffectiveAddress(&m_context, address, opcodeLo);
+			branchFallsThrough = !((id == 0x20) || (id == 0x21)); //B, BAL
+		}
+		else if(branchType != MIPS_BRANCH_NONE)
+		{
+			return true;
+		}
+
+		address += 8;
+	}
+}
