+		WriteName(stream, "env");
+		WriteName(stream, "linkBase");
+		stream.Write8(Wasm::IMPORT_EXPORT_TYPE_GLOBAL);
+		stream.Write8(Wasm::TYPE_I32);
+		stream.Write8(0x00); //Immutable
 	}
 
