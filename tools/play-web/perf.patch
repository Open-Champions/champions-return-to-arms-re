+	m_functionStream.Write8(0x00); //Signature index
+	m_functionStream.Write8(0x00); //Table index
+
+	if(m_externalSymbolReferencedHandler)
+	{
+		m_externalSymbolReferencedHandler(src1->GetConstantPtr(), slot, CCodeGen::SYMBOL_REF_TYPE::NATIVE_POINTER);
+	}
