+
+bool CVuExecutor::HasStickyFlagReaders() const
+{
+	//The lower word of every pair in program memory. A word that only looks like one of
+	//these (data, the float of an "I" pair) keeps the flags: safe.
+	enum
+	{
+		STATUS_STICKY_BITS = 0xFC0, //ZS, SS, US, OS, IS, DS
+	};
+	for(uint32 address = 0; address < m_maxAddress; address += 8)
+	{
+		uint32 lowerOp = m_context.m_pMemoryMap->GetInstruction(address);
+		switch(lowerOp >> 25)
+		{
+		case 0x14: //FSEQ
+		case 0x17: //FSOR
+			return true;
+		case 0x16: //FSAND: the status AND a 12-bit immediate
+		{
+			uint32 imm12 = ((lowerOp >> 10) & 0x800) | (lowerOp & 0x7FF);
+			if(imm12 & STATUS_STICKY_BITS) return true;
+		}
+		break;
+		}
+	}
+	return false;
+}
+
+void CVuExecutor::UpdateFlagsPolicy()
+{
+	m_flagsPolicyPending = false;
+	bool skipStickyFlags = m_flagsElision && !HasStickyFlagReaders();
+	if(skipStickyFlags != m_skipStickyFlags)
+	{
+		m_skipStickyFlags = skipStickyFlags;
+		printf("VU: sticky sign and zero flags are %s (the program memory has %s that reads them).\r\n",
+		       skipStickyFlags ? "not kept" : "kept", skipStickyFlags ? "no instruction" : "an instruction");
+	}
+	//Every block there is was made for the program as it was: what it does with its
+	//flags depends on the code around it
+	m_cachedBlocks.clear();
+	CGenericMipsExecutor::ClearActiveBlocksInRange(0, m_maxAddress, false);
+}
