+//RTA(web): The disc image is read where the call is made - on the machine's thread,
+//with a synchronous request for a range of bytes of a URL - instead of asking the page's
+//main thread for each piece and polling it until the piece has come. The URL is either
+//one the browser made for a file the player picked (URL.createObjectURL: the file is read
+//in place, nothing is copied or sent anywhere) or, for tests, a file served by a local
+//web server. Pieces of 128 KiB are fetched and the last 48 kept: the machine reads the
+//disc 2 KiB at a time.
+namespace
+{
+	const uint32 PIECE_SIZE = 0x20000;
+	const size_t PIECE_COUNT = 48;
+
+	char g_discUrl[4096] = "";
+	std::atomic<uint64> g_discSize(0);
+	std::atomic<uint32> g_discFetches(0);
+	std::atomic<uint32> g_discFetchMicros(0);
+	std::atomic<uint32> g_discErrors(0);
+
+	struct PIECE
+	{
+		uint64 position = 0;
+		std::vector<uint8> data;
+	};
+	std::mutex g_pieceMutex;
+	std::list<PIECE> g_pieces;
+	std::vector<uint32> g_fetched; //the number of every piece fetched, in order (for tests)
+}
+
+extern "C"
+{
+	EMSCRIPTEN_KEEPALIVE void RtaWebDiscSet(const char* url, double size)
+	{
+		std::lock_guard lock(g_pieceMutex);
+		strncpy(g_discUrl, url, sizeof(g_discUrl) - 1);
+		g_discSize = static_cast<uint64>(size);
+		g_pieces.clear();
+		g_fetched.clear();
+	}
+
+	//For tests: the number of the n-th piece fetched since the image was set, or -1
+	EMSCRIPTEN_KEEPALIVE int RtaWebDiscFetched(uint32 index)
+	{
+		std::lock_guard lock(g_pieceMutex);
+		return (index < g_fetched.size()) ? static_cast<int>(g_fetched[index]) : -1;
+	}
+
+	EMSCRIPTEN_KEEPALIVE uint32 RtaWebDiscCounter(int which)
+	{
+		switch(which)
+		{
+		case 0:
+			return g_discFetches;
+		case 1:
+			return g_discFetchMicros;
+		default:
+			return g_discErrors;
+		}
+	}
+}
+
+// clang-format off
+EM_JS_DEPS(RtaWebDisc, "$UTF8ToString");
+EM_JS(int, RtaWebDiscFetch, (const char* urlPtr, double position, void* buffer, int size), {
+	try {
+		const request = new XMLHttpRequest();
+		request.open("GET", UTF8ToString(urlPtr), false);
+		request.responseType = "arraybuffer";
+		request.setRequestHeader("Range", "bytes=" + position + "-" + (position + size - 1));
+		request.send();
+		if(request.status !== 206) return -request.status;
+		const data = new Uint8Array(request.response);
+		if(data.length > size) return -1;
+		HEAPU8.set(data, buffer);
+		return data.length;
+	} catch(e) {
+		err("disc: " + e);
+		return -2;
+	}
+});
+// clang-format on
+
+static bool RtaWebDiscRead(uint64 position, uint8* buffer, uint64 size)
+{
+	std::lock_guard lock(g_pieceMutex);
+	while(size != 0)
+	{
+		uint64 piecePosition = position & ~static_cast<uint64>(PIECE_SIZE - 1);
+		auto pieceIterator = g_pieces.begin();
+		for(; pieceIterator != g_pieces.end(); pieceIterator++)
+		{
+			if(pieceIterator->position == piecePosition) break;
+		}
+		if(pieceIterator == g_pieces.end())
+		{
+			PIECE piece;
+			piece.position = piecePosition;
+			uint64 discSize = g_discSize;
+			if(piecePosition >= discSize) return false;
+			uint32 wanted = static_cast<uint32>(std::min<uint64>(PIECE_SIZE, discSize - piecePosition));
+			piece.data.resize(wanted);
+			double start = emscripten_get_now();
+			int got = RtaWebDiscFetch(g_discUrl, static_cast<double>(piecePosition), piece.data.data(), static_cast<int>(wanted));
+			g_discFetches++;
+			g_fetched.push_back(static_cast<uint32>(piecePosition / PIECE_SIZE));
+			g_discFetchMicros += static_cast<uint32>((emscripten_get_now() - start) * 1000.0);
+			if(got != static_cast<int>(wanted))
+			{
+				g_discErrors++;
+				return false;
+			}
+			if(g_pieces.size() >= PIECE_COUNT) g_pieces.pop_back();
+			g_pieces.push_front(std::move(piece));
+			pieceIterator = g_pieces.begin();
+		}
+		else if(pieceIterator != g_pieces.begin())
+		{
+			g_pieces.splice(g_pieces.begin(), g_pieces, pieceIterator);
+			pieceIterator = g_pieces.begin();
+		}
+		uint64 offset = position - piecePosition;
+		if(offset >= pieceIterator->data.size()) return false;
+		uint64 count = std::min<uint64>(size, pieceIterator->data.size() - offset);
+		memcpy(buffer, pieceIterator->data.data() + offset, count);
+		buffer += count;
+		position += count;
+		size -= count;
+	}
+	return true;
+}
