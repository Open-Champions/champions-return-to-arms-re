+#ifdef __EMSCRIPTEN__
+//RTA(web): one turn of the video thread when it runs from its worker's event loop: the
+//calls that are waiting, up to and including one that hands a picture over. What was
+//drawn on the canvas is shown by the browser when the worker's task ends, so the turn
+//ends there. With nothing to do it waits a few milliseconds and ends too (the worker
+//has to come back to its event loop now and then anyway).
+void CGSHandler::WebThreadStep()
+{
+	m_webPresented = false;
+	if(!m_mailBox.IsPending())
+	{
+		m_mailBox.WaitForCall(4);
+	}
+	double start = emscripten_get_now();
+	while(m_mailBox.IsPending() && !m_webPresented)
+	{
+		m_mailBox.ReceiveCall();
+	}
+	g_webBusyMicros += static_cast<uint64>((emscripten_get_now() - start) * 1000.0);
+}
+#endif
