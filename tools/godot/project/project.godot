; The translated game of Champions: Return to Arms inside Godot - scripts and scenes only.
; No game content is in this project: the game library is built on the user's machine from
; the user's own disc (tools/godot/build.py) and loaded at run time.
config_version=5

[application]

config/name="Champions: Return to Arms - the translated game in Godot (spike)"
config/description="The statically recompiled game as the game logic; Godot does window, input, sound and drawing. Needs your own disc image."
run/main_scene="res://portal/portal.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[audio]

driver/mix_rate=48000

[display]

window/size/viewport_width=960
window/size/viewport_height=720
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
